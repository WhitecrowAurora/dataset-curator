<Window x:Class="Tagger.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tagger · NL + tag 打标工作台"
        Height="860" Width="1400"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI">

  <Grid>
    <!-- 网页本体 -->
    <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

    <!-- 启动 / 出错遮罩：服务没通之前不让用户看到空白页 -->
    <Border x:Name="Overlay" Background="{StaticResource BgBrush}">
      <Grid>
        <!-- 启动中 -->
        <StackPanel x:Name="LoadingPanel"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="520">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentBrush}">
              <TextBlock Text="T" Foreground="White" FontSize="17" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="TAGGER" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="15" FontWeight="SemiBold" />
          </StackPanel>

          <TextBlock x:Name="StatusText"
                     Text="正在启动本地服务…"
                     Margin="0,26,0,0"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="13" />

          <TextBlock x:Name="StatusDetail"
                     Text=""
                     Margin="0,7,0,0"
                     HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11.5" />

          <ProgressBar IsIndeterminate="True"
                       Height="2" Width="240" Margin="0,20,0,0"
                       Background="{StaticResource RaisedBrush}"
                       Foreground="{StaticResource AccentBrush}"
                       BorderThickness="0" />

          <TextBlock x:Name="HintText"
                     Margin="0,22,0,0"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource DimBrush}"
                     FontSize="11"
                     Text="首次启动要加载 Python 依赖，可能需要十几秒。" />
        </StackPanel>

        <!-- 出错 -->
        <StackPanel x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="720" Margin="32">
          <TextBlock Text="本地服务没能启动"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="16" FontWeight="SemiBold" />

          <TextBlock x:Name="ErrorText"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="12" LineHeight="19" />

          <!-- 未初始化引导：双击 exe 的人多数卡在这里，给一条一键路径 -->
          <Border x:Name="InstallPanel"
                  Visibility="Collapsed"
                  Margin="0,16,0,0"
                  Padding="14,12"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel>
              <TextBlock Text="这台机器还没装运行环境"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="13" FontWeight="SemiBold" />
              <TextBlock Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="11.5" LineHeight="18"
                         Text="要先建出 env\python 并装上依赖。点下面的按钮开始，需要联网，大约 3–10 分钟；装完会自动重新启动。这个过程可以关掉窗口中止。" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="InstallButton"
                        Content="初始化环境"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnInstallClick" />
                <TextBlock x:Name="InstallStage"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource DimBrush}"
                           FontSize="11" />
              </StackPanel>
              <ProgressBar x:Name="InstallProgress"
                           IsIndeterminate="True"
                           Visibility="Collapsed"
                           Height="2" Margin="0,10,0,0"
                           Background="{StaticResource RaisedBrush}"
                           Foreground="{StaticResource AccentBrush}"
                           BorderThickness="0" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <ScrollViewer x:Name="LogScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto">
              <TextBox x:Name="LogText"
                       IsReadOnly="True"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{StaticResource DimBrush}"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="11"
                       Padding="10,8"
                       TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="RetryButton" Content="重试" Style="{StaticResource PrimaryButton}" Click="OnRetryClick" />
            <Button Content="复制日志" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCopyClick" />
            <Button Content="用浏览器打开" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenBrowserClick" />
            <Button Content="退出" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnExitClick" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
