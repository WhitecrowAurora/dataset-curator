+def _list_drives() -> list[dict]:
+    """所有盘符 + 卷标；非 Windows 返回空表。
+
+    前端"选输入"要能一步换盘。没有它，用户想从 H: 跳到 D: 只能靠「上一级」
+    一路翻到根、再靠猜——素材散在几个盘上是常事，这一格省的是真时间。
+
+    卷标只对本地盘/可移动盘去问：映射的网络盘掉线时 GetVolumeInformationW
+    会卡几百毫秒到几秒，而这一步是每次点目录都要走的，不值得。
+    """
+    if os.name != "nt":
+        return []
+    import ctypes
+
+    k32 = ctypes.windll.kernel32
+    mask = k32.GetLogicalDrives()
+    out: list[dict] = []
+    for i in range(26):
+        if not mask & (1 << i):
+            continue
+        letter = chr(ord("A") + i)
+        if letter in ("A", "B"):
+            continue  # 软驱遗留盘符
+        root = f"{letter}:\\"
+        label = ""
+        # 2 = 可移动，3 = 本地固定盘
+        if k32.GetDriveTypeW(ctypes.c_wchar_p(root)) in (2, 3):
+            buf = ctypes.create_unicode_buffer(261)
+            try:
+                if k32.GetVolumeInformationW(
+                    ctypes.c_wchar_p(root), buf, 261, None, None, None, None, 0
+                ):
+                    label = buf.value
+            except OSError:
+                label = ""
+        out.append({"path": root, "label": label})
+    return out
+
